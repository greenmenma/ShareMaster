<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShareMaster.Server</RootNamespace>
    <ClientRoot>..\ShareMaster.Client\</ClientRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <!-- 発行時に React クライアントをビルドして wwwroot に含める（本番構成：Server が SPA を配信） -->
  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci" />
    <!-- サブフォルダ配置時は -p:ClientBasePath=/ShareMaster/ のように指定する（未指定はルート配置） -->
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build" EnvironmentVariables="BASE_PATH=$(ClientBasePath)" />
    <ItemGroup>
      <ClientDistFiles Include="$(ClientRoot)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
