<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <!-- ローカル開発・デバッグ専用のオーケストレーター（本番デプロイには含めない） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Aspire CLI バンドルは使用せず dotnet run / IDE から起動する -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>7d1c3f8e-6b1a-4f0e-9f2b-5a3d6c2e1b40</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShareMaster.Server\ShareMaster.Server.csproj" />
  </ItemGroup>

</Project>
