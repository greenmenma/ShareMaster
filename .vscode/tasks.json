{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: server",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/ShareMaster.Server/ShareMaster.Server.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build: apphost",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/ShareMaster.AppHost/ShareMaster.AppHost.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: solution",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/ShareMaster.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "dotnet test ShareMaster.slnx && npm --prefix src/ShareMaster.Client test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "client: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/src/ShareMaster.Client" },
      "problemMatcher": "$tsc"
    }
  ]
}
