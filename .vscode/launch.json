{
  // VS Code のデバッグ構成（docs/03_開発環境.md 参照）。C# 拡張機能（ms-dotnettools.csharp）のみで動作する
  "version": "0.2.0",
  "configurations": [
    {
      // C# と React を両方デバッグする場合はこれ（複合構成「全体: Server + Vite + Chrome」）
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: server",
      "program": "${workspaceFolder}/src/ShareMaster.Server/bin/Debug/net10.0/ShareMaster.Server.dll",
      "cwd": "${workspaceFolder}/src/ShareMaster.Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5148"
      },
      "console": "internalConsole"
    },
    {
      // Aspire ダッシュボード付きで Server と Vite を起動する（コンテナは使わない）
      "name": "Aspire: AppHost",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: apphost",
      "program": "${workspaceFolder}/src/ShareMaster.AppHost/bin/Debug/net10.0/ShareMaster.AppHost.dll",
      "cwd": "${workspaceFolder}/src/ShareMaster.AppHost",
      "launchSettingsFilePath": "${workspaceFolder}/src/ShareMaster.AppHost/Properties/launchSettings.json",
      "launchSettingsProfile": "http",
      "console": "internalConsole"
    },
    {
      // Aspire で起動した Server にブレークポイントを効かせる場合に使う（一覧から ShareMaster.Server を選択）
      "name": "Server: プロセスにアタッチ",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Client: Vite 開発サーバー",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --port 5173 --strictPort",
      "cwd": "${workspaceFolder}/src/ShareMaster.Client"
    },
    {
      // Vite（Aspire 起動・単独起動どちらも 5173）にブラウザデバッガーを接続する
      "name": "Client: Chrome でデバッグ",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/ShareMaster.Client",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"
    },
    {
      "name": "Client: Edge でデバッグ",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/ShareMaster.Client",
      "userDataDir": "${workspaceFolder}/.vscode/edge-debug-profile"
    }
  ],
  "compounds": [
    {
      "name": "全体: Server + Vite + Chrome",
      "configurations": ["Server", "Client: Vite 開発サーバー", "Client: Chrome でデバッグ"],
      "stopAll": true
    },
    {
      "name": "全体: Server + Vite + Edge",
      "configurations": ["Server", "Client: Vite 開発サーバー", "Client: Edge でデバッグ"],
      "stopAll": true
    },
    {
      "name": "全体: Aspire + Chrome",
      "configurations": ["Aspire: AppHost", "Client: Chrome でデバッグ"],
      "stopAll": true
    }
  ]
}
